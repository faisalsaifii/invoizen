# Supabase project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Optional: canonical site URL, used for SEO metadata, sitemap and robots.txt.
# Falls back to VERCEL_URL, then http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://invoizen.example.com

# Google Gemini API key — used by the extraction pipeline.
# Get one at https://aistudio.google.com/apikey
# NOTE: keep this server-side only. Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key

# Optional: LLM model override (defaults to gemini-3.5-flash).
# GEMINI_MODEL=gemini-3.5-flash

# Optional: cheaper models used on retry, comma-separated, in order.
# Defaults to the primary model's "-flash-lite" sibling.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite